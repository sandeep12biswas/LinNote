{
  "name": "@linnote/plugin-playground",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Vite + React harness that boots a single plugin against a mocked PluginContext, no Tauri app and no other plugins involved (Plugins §6). Every plugins/* package's own `dev` script points here.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@linnote/plugin-sdk": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "@vitejs/plugin-react": "^4.6.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "vitest": "^2.1.4"
  }
}
